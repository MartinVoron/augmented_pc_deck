#!/bin/sh
# Empêche de pousser directement sur main (passer par une Pull Request).
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "✖ Push direct sur main interdit : créez une branche et ouvrez une Pull Request." >&2
    echo "  (contournement exceptionnel : git push --no-verify)" >&2
    exit 1
  fi
done
exit 0
