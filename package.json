{
  "name": "augmented-pc-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "lint": "npm run lint:front && npm run lint:rust",
    "lint:front": "eslint . && prettier --check .",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tauri-apps/cli": "^2.12.6",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0"
  }
}
