{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Augmented PC Deck",
  "version": "0.1.0",
  "identifier": "fr.martinvoron.augmented-pc-deck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Augmented PC Deck",
        "width": 1024,
        "height": 640,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Martin Voron",
    "copyright": "© 2026 Martin Voron. Licence MIT.",
    "homepage": "https://github.com/MartinVoron/augmented_pc_deck",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Tableau de bord de bureau pour Windows, façon Stream Deck",
    "longDescription": "Raccourcis d'applications, gestionnaire de tâches, minuteurs, liste de tâches, musique en cours, GitHub, Gmail et notifications de Claude Code, dans une seule fenêtre.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
